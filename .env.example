# Example env file for docker compose (optional)
# Copy it to .env at the project root to override the defaults of docker-compose.yml
# For example:
# JUPYTER_TOKEN=yourtoken

# Official Apache Spark image (https://hub.docker.com/_/spark), used by the master, the
# workers and as the base of the Jupyter image. Default (no .env): spark:4.0.0-java21-python3
# PYSPARK_VERSION (pip, in the Jupyter image) must be the same Spark version.
# Examples (choose one and copy to .env without '#'):
# SPARK_IMAGE=spark:4.0.0-java21-python3
# PYSPARK_VERSION=4.0.0
# SPARK_IMAGE=spark:3.5.7-scala2.12-java17-python3-ubuntu
# PYSPARK_VERSION=3.5.7
